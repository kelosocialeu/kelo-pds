# ============================================================
# KELO PDS — RENDER ENVIRONMENT TEMPLATE
# Never commit real secret values.
# ============================================================

# --- Service / identity ---
PDS_PORT=10000
PDS_HOSTNAME=pds.kelosocial.eu
PDS_SERVICE_NAME=Kelo Social PDS
PDS_SERVICE_HANDLE_DOMAINS=.kelosocial.eu
PDS_HOME_URL=https://kelosocial.eu
PDS_LOGO_URL=https://kelosocial.sirv.com/logo.png
PDS_CONTACT_EMAIL_ADDRESS=support@kelosocial.eu
PDS_PRIVACY_POLICY_URL=https://kelosocial.eu/privacy
PDS_TERMS_OF_SERVICE_URL=https://kelosocial.eu/terms

# --- Permanent secrets ---
# Generate JWT/admin/DPOP with: openssl rand --hex 32
PDS_JWT_SECRET=CHANGE_ME
PDS_ADMIN_PASSWORD=CHANGE_ME
PDS_DPOP_SECRET=CHANGE_ME

# Generate with:
# openssl ecparam --name secp256k1 --genkey --noout --outform DER | tail -c +8 | head -c 32 | xxd -p -c 32
PDS_PLC_ROTATION_KEY_K256_PRIVATE_KEY_HEX=CHANGE_ME_64_HEX

# --- Persistent storage ---
PDS_DATA_DIRECTORY=/pds
PDS_BLOBSTORE_DISK_LOCATION=/pds/blocks
PDS_BLOBSTORE_DISK_TMP_LOCATION=/pds/tmp
PDS_BLOB_UPLOAD_LIMIT=104857600

# Optional S3-compatible production blob store. If enabled, remove
# PDS_BLOBSTORE_DISK_LOCATION from Render and configure these values.
# PDS_BLOBSTORE_S3_BUCKET=
# PDS_BLOBSTORE_S3_REGION=
# PDS_BLOBSTORE_S3_ENDPOINT=
# PDS_BLOBSTORE_S3_FORCE_PATH_STYLE=false
# PDS_BLOBSTORE_S3_ACCESS_KEY_ID=
# PDS_BLOBSTORE_S3_SECRET_ACCESS_KEY=

# --- Main AT Protocol network ---
PDS_DID_PLC_URL=https://plc.directory
PDS_BSKY_APP_VIEW_URL=https://api.bsky.app
PDS_BSKY_APP_VIEW_DID=did:web:api.bsky.app
PDS_REPORT_SERVICE_URL=https://mod.bsky.app
PDS_REPORT_SERVICE_DID=did:plc:ar7c4by46qjdydhdevvrndac
PDS_CRAWLERS=https://bsky.network

# --- Open signup + native PDS hCaptcha ---
PDS_INVITE_REQUIRED=false
PDS_HCAPTCHA_SITE_KEY=CHANGE_ME
PDS_HCAPTCHA_SECRET_KEY=CHANGE_ME
# Generate with: openssl rand --hex 32
PDS_HCAPTCHA_TOKEN_SALT=CHANGE_ME

# --- Email ---
# Example Resend SMTP URL:
# smtps://resend:API_KEY@smtp.resend.com:465/
PDS_EMAIL_SMTP_URL=CHANGE_ME
PDS_EMAIL_FROM_ADDRESS=Kelo Social <noreply@kelosocial.eu>

# --- Security / rate limits ---
PDS_RATE_LIMITS_ENABLED=true
PDS_DISABLE_SSRF_PROTECTION=false
LOG_ENABLED=true
LOG_LEVEL=info

# Optional shared Redis/Valkey scratch state for a later multi-process setup.
# PDS_REDIS_SCRATCH_ADDRESS=internal-host:6379
# PDS_REDIS_SCRATCH_PASSWORD=CHANGE_ME

# --- Optional branding ---
PDS_PRIMARY_COLOR=#7d4cff
PDS_PRIMARY_COLOR_CONTRAST=#ffffff
PDS_LIGHT_COLOR=#ffffff
PDS_DARK_COLOR=#111111
